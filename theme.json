{
    "$schema": "https://schemas.wp.org/wp/x.x/theme.json",
    "version": 1,
    "settings": {
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1600px"
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "Helvetica Neue,sans-serif",
                    "slug": "helvetica-neue",
                    "name": "Helvetica Neue"
                }
            ]
        }        
    },
    "styles": {
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--helvetica-neue)"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontWeight": "700",
                    "fontSize": "36px",
                    "lineHeight": "1.5em"
                },
                "spacing": {
                    "margin": {
                        "bottom": "24px"
                    }
                }                
            }
        }              
    }    
}